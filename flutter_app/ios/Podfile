# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end

  end

  # BoringSSL-GRPC hardcodes -GCC_WARN_INHIBIT_ALL_WARNINGS in each source
  # file's COMPILER_FLAGS. Clang 16+ (Xcode 16) parses this as -G <arg>,
  # which is unsupported on Apple targets. Strip it from every build file.
  installer.pods_project.targets.each do |target|
    if target.name == 'BoringSSL-GRPC'
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          file.settings['COMPILER_FLAGS'] =
            file.settings['COMPILER_FLAGS'].gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '')
        end
      end
    end
  end
  installer.pods_project.save

  # gRPC-Core and gRPC-C++ 1.62.5 use `Traits::template CallSeqFactory(` without
  # explicit template args. Clang 16 (Xcode 16) strictly requires `<>` after the
  # `template` keyword, rejecting deduced calls. Remove the unnecessary keyword.
  ['gRPC-Core', 'gRPC-C++'].each do |pod_name|
    basic_seq_path = "#{installer.sandbox.root}/#{pod_name}/src/core/lib/promise/detail/basic_seq.h"
    if File.exist?(basic_seq_path)
      content = File.read(basic_seq_path)
      patched = content.gsub('Traits::template CallSeqFactory(', 'Traits::CallSeqFactory(')
      File.write(basic_seq_path, patched) if patched != content
    end
  end

  # firebase_auth private headers use `#import <Firebase/Firebase.h>` (an
  # umbrella header spanning multiple frameworks). Xcode 26 rejects this in
  # modular compilation ("non-modular include inside framework module").
  # Replace with the modular equivalent so the header is self-contained.
  Dir.glob("#{installer.sandbox.root}/firebase_auth/**/*.h").each do |header|
    content = File.read(header)
    if content.include?('#import <Firebase/Firebase.h>')
      patched = content.gsub(
        '#import <Firebase/Firebase.h>',
        '@import FirebaseCore; @import FirebaseAuth;'
      )
      File.write(header, patched)
    end
  end
end
